# Runtime mode: development, test, or production.
NODE_ENV=development

# HTTP server configuration.
PORT=5000

# MongoDB connection and database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=property_rental

# Use a random value with at least 24 characters.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# One or more allowed frontend origins, separated by commas.
CLIENT_URL=http://localhost:3000

# Optional for local development; required when using payments.
STRIPE_SECRET_KEY=sk_test_replace_me

# Required for image uploads and required whenever NODE_ENV=production.
IMGBB_API_KEY=replace_with_imgbb_api_key

# Optional until Google sign-in is enabled.
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id

# Use false for local HTTP and true for HTTPS deployments.
COOKIE_SECURE=false
